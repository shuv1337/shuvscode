diff --git i/extensions/github-authentication/src/node/ghCli.ts w/extensions/github-authentication/src/node/ghCli.ts
new file mode 100644
index 00000000000..04cfeb0a4cb
--- /dev/null
+++ w/extensions/github-authentication/src/node/ghCli.ts
@@ -0,0 +1,176 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) shuvscode contributors.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// shuvscode: lightweight wrapper around the system `gh` CLI so the GitHub
+// authentication provider can satisfy `vscode.authentication.getSession`
+// requests without launching a browser.
+//
+// This file is the node-side implementation. The browser implementation
+// in `../browser/ghCli.ts` is a stub that always reports unavailable; the
+// esbuild plugin in `esbuild.browser.mts` rewrites `./node/ghCli` imports
+// to `./browser/ghCli` for the web build.
+
+import { execFile } from 'child_process';
+import { Log } from '../common/logger';
+
+export interface GhCliTokenResult {
+	token: string;
+	user: string;
+	tokenScopes: string[];
+}
+
+const DEFAULT_TIMEOUT_MS = 5_000;
+
+function run(cmd: string, args: string[], timeoutMs = DEFAULT_TIMEOUT_MS): Promise<{ code: number; stdout: string; stderr: string }> {
+	return new Promise(resolve => {
+		let settled = false;
+		const child = execFile(cmd, args, { timeout: timeoutMs, encoding: 'utf8' }, (err, stdout, stderr) => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			if (err && (err as NodeJS.ErrnoException).code === 'ENOENT') {
+				resolve({ code: -1, stdout: '', stderr: 'gh: not found' });
+				return;
+			}
+			const rawCode = (err as { code?: unknown } | null)?.code;
+			const code: number = typeof rawCode === 'number' ? rawCode : (rawCode ? 1 : 0);
+			resolve({
+				code,
+				stdout: String(stdout ?? ''),
+				stderr: String(stderr ?? '')
+			});
+		});
+		child.on('error', e => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			resolve({ code: -1, stdout: '', stderr: e.message });
+		});
+	});
+}
+
+/**
+ * Returns `true` when `gh --version` succeeds, indicating the GitHub CLI
+ * is installed and runnable. This is a fast no-op when `gh` is missing.
+ */
+export async function isGhCliAvailable(): Promise<boolean> {
+	const result = await run('gh', ['--version'], 2_000);
+	return result.code === 0;
+}
+
+/**
+ * Returns the OAuth token, user login, and scopes for the active `gh`
+ * authentication on github.com. Throws if `gh` is missing, not signed in,
+ * or otherwise fails.
+ */
+export async function getGhCliToken(logger: Log, host = 'github.com'): Promise<GhCliTokenResult> {
+	logger.info('Attempting to retrieve token from gh CLI...');
+
+	const tokenResult = await run('gh', ['auth', 'token', '--hostname', host]);
+	if (tokenResult.code !== 0) {
+		const message = (tokenResult.stderr || tokenResult.stdout).trim() || 'gh auth token failed';
+		throw new GhCliError(message);
+	}
+	const token = tokenResult.stdout.trim();
+	if (!token) {
+		throw new GhCliError('gh auth token returned an empty value');
+	}
+
+	// `gh auth status` prints token scopes on stderr.
+	const statusResult = await run('gh', ['auth', 'status', '--hostname', host, '--show-token']);
+	const statusText = `${statusResult.stderr}\n${statusResult.stdout}`;
+
+	let user = '';
+	const userMatch = statusText.match(/Logged in to [^ ]+ (?:as|account) ([^\s(]+)/i);
+	if (userMatch) {
+		user = userMatch[1];
+	}
+
+	let tokenScopes: string[] = [];
+	const scopeMatch = statusText.match(/Token scopes:\s*([^\n]+)/i);
+	if (scopeMatch) {
+		tokenScopes = scopeMatch[1]
+			.split(',')
+			.map(s => s.trim().replace(/^['"`]|['"`]$/g, ''))
+			.filter(Boolean);
+	}
+
+	if (!user) {
+		// Fallback to API call to discover the login.
+		const apiResult = await run('gh', ['api', 'user', '--jq', '.login']);
+		if (apiResult.code === 0) {
+			user = apiResult.stdout.trim();
+		}
+	}
+
+	if (!user) {
+		user = '<unknown>';
+	}
+
+	logger.info(`Got token from gh CLI for ${user} with scopes: ${tokenScopes.join(', ') || '<none reported>'}`);
+	return { token, user, tokenScopes };
+}
+
+export class GhCliError extends Error {
+	constructor(message: string) {
+		super(message);
+		this.name = 'GhCliError';
+	}
+}
+
+/**
+ * Checks whether `tokenScopes` (as reported by `gh auth status`) satisfies
+ * the GitHub OAuth scope string requested by the extension. Returns the
+ * missing scopes, or `[]` when fully satisfied.
+ *
+ * Semantics (matching GitHub OAuth scope inclusion rules):
+ *  - Exact match always satisfies (`repo` covers `repo`).
+ *  - Parent namespace covers child (`user` covers `read:user` and `user:email`;
+ *    `admin:org` covers `write:org` and `read:org`; `repo` covers `repo:status`,
+ *    `repo:invite`, `public_repo`, etc).
+ *
+ * What this intentionally does NOT do:
+ *  - Sibling scopes do not satisfy each other. `read:org` does NOT satisfy
+ *    `read:user` even though they share the `read:` prefix -- they live in
+ *    completely different scope hierarchies (`org` vs `user`).
+ */
+export function findMissingScopes(requestedScopes: string, tokenScopes: string[]): string[] {
+	const requested = requestedScopes.split(/\s+/).filter(Boolean);
+	const present = new Set(tokenScopes);
+	const missing: string[] = [];
+	for (const scope of requested) {
+		if (present.has(scope)) {
+			continue;
+		}
+		// Parent namespace covers child: `user` -> `read:user`, `user:email`.
+		if (scope.includes(':')) {
+			const parent = scope.split(':')[0];
+			if (parent && present.has(parent)) {
+				continue;
+			}
+			// `admin:<x>` covers `write:<x>` covers `read:<x>`.
+			const [tier, namespace] = scope.split(':');
+			if (namespace) {
+				if (tier === 'read' && (present.has(`write:${namespace}`) || present.has(`admin:${namespace}`))) {
+					continue;
+				}
+				if (tier === 'write' && present.has(`admin:${namespace}`)) {
+					continue;
+				}
+			}
+		}
+		// `repo` (full) covers `public_repo`, `repo:status`, `repo:invite`,
+		// `repo_deployment`, `security_events`.
+		if (present.has('repo')) {
+			if (scope === 'public_repo' || scope === 'repo_deployment' || scope === 'security_events' || scope.startsWith('repo:')) {
+				continue;
+			}
+		}
+		missing.push(scope);
+	}
+	return missing;
+}

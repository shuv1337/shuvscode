+
+// Browser stub for the gh CLI helper. The CLI is by definition unavailable
+// inside a web worker / browser extension host, so all functions return
+// "not available" results. The matching node implementation lives in
+// `../node/ghCli.ts`.
+
+import { Log } from '../common/logger';
+
+export interface GhCliTokenResult {
+	token: string;
+	user: string;
+	tokenScopes: string[];
+}
+
+export async function isGhCliAvailable(): Promise<boolean> {
+	return false;
+}
+
+export async function getGhCliToken(_logger: Log, _host = 'github.com'): Promise<GhCliTokenResult> {
+	throw new GhCliError('gh CLI is not available in browser extension hosts');
+}
+
+export class GhCliError extends Error {
+	constructor(message: string) {
+		super(message);
+		this.name = 'GhCliError';
+	}
+}
+
+export function findMissingScopes(_requestedScopes: string, _tokenScopes: string[]): string[] {
+	return [];
+}

 		}
 		this._logService.info(`Persistent process "${this._persistentProcessId}": Replaying ${dataLength} chars and ${ev.events.length} size events`);
 		this._onProcessReplay.fire(ev);
+		// shuvscode: if the terminal was on the alternate screen buffer (a TUI
+		// like zellij/tmux/nvim), the cell snapshot the renderer just replayed
+		// is stale and the foreground process is unaware its client changed.
+		// After the renderer has settled into its real layout size, force a
+		// SIGWINCH on the pty by bumping the size by one row and restoring it.
+		// We read cols/rows from the serializer at fire time so we use the
+		// renderer's current dimensions (set via resize() after replay), not
+		// the stale recorded dimensions baked into the replay event. The 250ms
+		// delay gives the renderer time to issue its post-attach resize so we
+		// don't squish the multiplexer into the recorded background size.
+		if (ev.altBufferActive) {
+			setTimeout(() => {
+				try {
+					const dims = this._serializer.getCurrentDimensions?.();
+					if (!dims || dims.cols <= 0 || dims.rows <= 0) {
+						return;
+					}
+					this._terminalProcess.resize(dims.cols, dims.rows + 1);
+					setTimeout(() => {
+						try {
+							const d2 = this._serializer.getCurrentDimensions?.();
+							if (d2 && d2.cols > 0 && d2.rows > 0) {
+								this._terminalProcess.resize(d2.cols, d2.rows);
+							}
+						} catch { /* pty may have exited; ignore */ }
+					}, 50);
+				} catch { /* pty may have exited; ignore */ }
+			}, 250);
+		}
 		this._terminalProcess.clearUnacknowledgedChars();
 		this._onPersistentProcessReady.fire();
 	}

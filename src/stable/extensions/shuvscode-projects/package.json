{
  "name": "shuvscode-projects",
  "displayName": "shuvscode Projects",
  "description": "Native project switcher for shuvscode.",
  "version": "0.1.0",
  "publisher": "shuvscode",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onView:shuvscodeProjects.projects",
    "onCommand:shuvscodeProjects.saveProject",
    "onCommand:shuvscodeProjects.addProjectToFavorites",
    "onCommand:shuvscodeProjects.editProjects",
    "onCommand:shuvscodeProjects.openProject",
    "onCommand:shuvscodeProjects.openProjectInNewWindow",
    "onCommand:shuvscodeProjects.refresh",
    "onCommand:shuvscodeProjects.removeProject",
    "onCommand:shuvscodeProjects.revealProjectFile",
    "onCommand:shuvscodeProjects.switchToWindow"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shuvscode-projects",
          "title": "Projects",
          "icon": "$(folder-library)"
        }
      ]
    },
    "views": {
      "shuvscode-projects": [
        {
          "id": "shuvscodeProjects.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "shuvscodeProjects.projects",
        "contents": "Add this workspace to Favorites or configure base folders to start switching between projects.\n[Add Current Project to Favorites](command:shuvscodeProjects.saveProject)\n[Open Project Settings](command:workbench.action.openSettings?%5B%22shuvscode.projects%22%5D)"
      }
    ],
    "commands": [
      {
        "command": "shuvscodeProjects.saveProject",
        "title": "Add Current Project to Favorites",
        "category": "Projects",
        "icon": "$(star-add)"
      },
      {
        "command": "shuvscodeProjects.addProjectToFavorites",
        "title": "Add Project to Favorites",
        "category": "Projects",
        "icon": "$(star-add)"
      },
      {
        "command": "shuvscodeProjects.editProjects",
        "title": "Edit Favorites JSON",
        "category": "Projects",
        "icon": "$(json)"
      },
      {
        "command": "shuvscodeProjects.openProject",
        "title": "Open Project in This Window",
        "category": "Projects",
        "icon": "$(folder-opened)"
      },
      {
        "command": "shuvscodeProjects.openProjectInNewWindow",
        "title": "Open Project in New Window",
        "category": "Projects",
        "icon": "$(empty-window)"
      },
      {
        "command": "shuvscodeProjects.refresh",
        "title": "Refresh Project List",
        "category": "Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "shuvscodeProjects.removeProject",
        "title": "Remove from Favorites",
        "category": "Projects",
        "icon": "$(trash)"
      },
      {
        "command": "shuvscodeProjects.revealProjectFile",
        "title": "Reveal Projects File",
        "category": "Projects",
        "icon": "$(go-to-file)"
      },
      {
        "command": "shuvscodeProjects.switchToWindow",
        "title": "Switch to Open Window",
        "category": "Projects",
        "icon": "$(multiple-windows)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "shuvscodeProjects.refresh",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.removeProject",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.revealProjectFile",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.switchToWindow",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "shuvscodeProjects.saveProject",
          "when": "view == shuvscodeProjects.projects",
          "group": "navigation@1"
        },
        {
          "command": "shuvscodeProjects.refresh",
          "when": "view == shuvscodeProjects.projects",
          "group": "navigation@2"
        },
        {
          "command": "shuvscodeProjects.editProjects",
          "when": "view == shuvscodeProjects.projects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "shuvscodeProjects.openProject",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/",
          "group": "inline@1"
        },
        {
          "command": "shuvscodeProjects.openProjectInNewWindow",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/",
          "group": "inline@2"
        },
        {
          "command": "shuvscodeProjects.addProjectToFavorites",
          "when": "view == shuvscodeProjects.projects && viewItem == project",
          "group": "inline@3"
        },
        {
          "command": "shuvscodeProjects.removeProject",
          "when": "view == shuvscodeProjects.projects && viewItem == projectFavorite",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "shuvscode Projects",
      "properties": {
        "shuvscode.projects.baseFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "$home/repos",
            "$home/projects",
            "$home/code",
            "$home/src"
          ],
          "description": "Folders scanned for Git repositories. Supports ~ and $home."
        },
        "shuvscode.projects.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".cache",
            ".git",
            "dist",
            "out",
            "target"
          ],
          "description": "Folder names ignored while scanning base folders."
        },
        "shuvscode.projects.maxDepthRecursion": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 12,
          "description": "Maximum folder depth for Git project discovery."
        },
        "shuvscode.projects.sortList": {
          "type": "string",
          "enum": [
            "Saved",
            "Name",
            "Path",
            "Recent"
          ],
          "default": "Name",
          "description": "Sort order for project lists."
        },
        "shuvscode.projects.groupList": {
          "type": "boolean",
          "default": true,
          "description": "Group projects by Favorites and auto-detected Git repositories."
        },
        "shuvscode.projects.checkInvalidPathsBeforeListing": {
          "type": "boolean",
          "default": true,
          "description": "Mark saved projects whose paths no longer exist."
        },
        "shuvscode.projects.showProjectNameInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current project in the status bar."
        },
        "shuvscode.projects.showOpenWindows": {
          "type": "boolean",
          "default": true,
          "description": "Show a pinned 'Open Windows' section at the top of the Projects view listing other shuvscode windows that are currently open."
        },
        "shuvscode.projects.projectsLocation": {
          "type": "string",
          "default": "",
          "description": "Optional folder for projects.json. Supports ~ and $home."
        }
      }
    }
  }
}

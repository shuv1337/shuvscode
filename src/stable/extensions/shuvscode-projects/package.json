{
  "name": "shuvscode-projects",
  "displayName": "shuvscode Projects",
  "description": "Native project switcher for shuvscode.",
  "version": "0.1.0",
  "publisher": "shuvscode",
  "engines": {
    "vscode": "*"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "*",
    "onStartupFinished",
    "onView:shuvscodeProjects.projects",
    "onCommand:shuvscodeProjects.saveProject",
    "onCommand:shuvscodeProjects.addProjectToFavorites",
    "onCommand:shuvscodeProjects.editProjects",
    "onCommand:shuvscodeProjects.openProject",
    "onCommand:shuvscodeProjects.openProjectWorkspace",
    "onCommand:shuvscodeProjects.openProjectInNewWindow",
    "onCommand:shuvscodeProjects.openActiveProjectAsWorkspace",
    "onCommand:shuvscodeProjects.refresh",
    "onCommand:shuvscodeProjects.refreshZellijState",
    "onCommand:shuvscodeProjects.removeProject",
    "onCommand:shuvscodeProjects.revealProjectFile",
    "onCommand:shuvscodeProjects.switchToWindow",
    "onCommand:shuvscodeProjects.openMultiplexerTerminal",
    "onCommand:shuvscodeProjects.openManagedZellij",
    "onCommand:shuvscodeProjects.fastSwitchProject"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shuvscode-projects",
          "title": "Projects",
          "icon": "$(folder-library)"
        }
      ]
    },
    "views": {
      "shuvscode-projects": [
        {
          "id": "shuvscodeProjects.projects",
          "name": "Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "shuvscodeProjects.projects",
        "contents": "Add this workspace to Favorites or configure base folders to start switching between projects.\n[Add Current Project to Favorites](command:shuvscodeProjects.saveProject)\n[Open Project Settings](command:workbench.action.openSettings?%5B%22shuvscode.projects%22%5D)"
      }
    ],
    "commands": [
      {
        "command": "shuvscodeProjects.saveProject",
        "title": "Add Current Project to Favorites",
        "category": "Projects",
        "icon": "$(star-add)"
      },
      {
        "command": "shuvscodeProjects.addProjectToFavorites",
        "title": "Add Project to Favorites",
        "category": "Projects",
        "icon": "$(star-add)"
      },
      {
        "command": "shuvscodeProjects.editProjects",
        "title": "Edit Favorites JSON",
        "category": "Projects",
        "icon": "$(json)"
      },
      {
        "command": "shuvscodeProjects.openProject",
        "title": "Open Project in This Window",
        "category": "Projects",
        "icon": "$(folder-opened)"
      },
      {
        "command": "shuvscodeProjects.openProjectWorkspace",
        "title": "Open Project Workspace",
        "category": "Projects",
        "icon": "$(folder-opened)"
      },
      {
        "command": "shuvscodeProjects.openProjectInNewWindow",
        "title": "Open Project in New Window",
        "category": "Projects",
        "icon": "$(empty-window)"
      },
      {
        "command": "shuvscodeProjects.openActiveProjectAsWorkspace",
        "title": "Open Active Project as Workspace",
        "category": "Projects",
        "icon": "$(folder-active)"
      },
      {
        "command": "shuvscodeProjects.refresh",
        "title": "Refresh Project List",
        "category": "Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "shuvscodeProjects.refreshZellijState",
        "title": "Refresh Zellij State",
        "category": "Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "shuvscodeProjects.removeProject",
        "title": "Remove from Favorites",
        "category": "Projects",
        "icon": "$(trash)"
      },
      {
        "command": "shuvscodeProjects.revealProjectFile",
        "title": "Reveal Projects File",
        "category": "Projects",
        "icon": "$(go-to-file)"
      },
      {
        "command": "shuvscodeProjects.switchToWindow",
        "title": "Switch to Open Window",
        "category": "Projects",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "shuvscodeProjects.openMultiplexerTerminal",
        "title": "Open Multiplexer Terminal",
        "category": "Projects",
        "icon": "$(terminal-tmux)"
      },
      {
        "command": "shuvscodeProjects.openManagedZellij",
        "title": "Open Managed Zellij Session",
        "category": "Projects",
        "icon": "$(terminal-tmux)"
      },
      {
        "command": "shuvscodeProjects.fastSwitchProject",
        "title": "Fast Switch Project",
        "category": "Projects",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "shuvscodeProjects.refresh",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.removeProject",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.revealProjectFile",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.switchToWindow",
          "when": "false"
        },
        {
          "command": "shuvscodeProjects.openProjectWorkspace",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "shuvscodeProjects.saveProject",
          "when": "view == shuvscodeProjects.projects",
          "group": "navigation@1"
        },
        {
          "command": "shuvscodeProjects.refresh",
          "when": "view == shuvscodeProjects.projects",
          "group": "navigation@2"
        },
        {
          "command": "shuvscodeProjects.editProjects",
          "when": "view == shuvscodeProjects.projects",
          "group": "navigation@3"
        },
        {
          "command": "shuvscodeProjects.openManagedZellij",
          "when": "view == shuvscodeProjects.projects && shuvscode.projects.zellij.enabled",
          "group": "navigation@4"
        },
        {
          "command": "shuvscodeProjects.refreshZellijState",
          "when": "view == shuvscodeProjects.projects && shuvscode.projects.zellij.enabled",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "shuvscodeProjects.addProjectToFavorites",
          "when": "view == shuvscodeProjects.projects && (viewItem == project || viewItem =~ /openWindow/)",
          "group": "inline@1"
        },
        {
          "command": "shuvscodeProjects.fastSwitchProject",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/ && shuvscode.projects.zellij.enabled",
          "group": "inline@2"
        },
        {
          "command": "shuvscodeProjects.openProject",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/",
          "group": "inline@3"
        },
        {
          "command": "shuvscodeProjects.openProjectInNewWindow",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/",
          "group": "inline@4"
        },
        {
          "command": "shuvscodeProjects.removeProject",
          "when": "view == shuvscodeProjects.projects && viewItem == projectFavorite",
          "group": "navigation@3"
        },
        {
          "command": "shuvscodeProjects.openMultiplexerTerminal",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/",
          "group": "inline@5"
        },
        {
          "command": "shuvscodeProjects.openManagedZellij",
          "when": "view == shuvscodeProjects.projects && viewItem =~ /project/ && shuvscode.projects.zellij.enabled",
          "group": "inline@6"
        }
      ]
    },
    "configuration": {
      "title": "shuvscode Projects",
      "properties": {
        "shuvscode.projects.baseFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "$home/repos",
            "$home/projects",
            "$home/code",
            "$home/src"
          ],
          "description": "Folders scanned for Git repositories. Supports ~ and $home."
        },
        "shuvscode.projects.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".cache",
            ".git",
            "dist",
            "out",
            "target"
          ],
          "description": "Folder names ignored while scanning base folders."
        },
        "shuvscode.projects.maxDepthRecursion": {
          "type": "number",
          "default": 4,
          "minimum": 0,
          "maximum": 12,
          "description": "Maximum folder depth for Git project discovery."
        },
        "shuvscode.projects.sortList": {
          "type": "string",
          "enum": [
            "Saved",
            "Name",
            "Path",
            "Recent"
          ],
          "default": "Name",
          "description": "Sort order for project lists."
        },
        "shuvscode.projects.groupList": {
          "type": "boolean",
          "default": true,
          "description": "Group projects by Favorites and auto-detected Git repositories."
        },
        "shuvscode.projects.checkInvalidPathsBeforeListing": {
          "type": "boolean",
          "default": true,
          "description": "Mark saved projects whose paths no longer exist."
        },
        "shuvscode.projects.showProjectNameInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current project in the status bar."
        },
        "shuvscode.projects.showOpenWindows": {
          "type": "boolean",
          "default": true,
          "description": "Show a pinned 'Open Windows' section at the top of the Projects view listing other shuvscode windows that are currently open."
        },
        "shuvscode.projects.defaultProjectAction": {
          "type": "string",
          "enum": [
            "open-workspace",
            "fast-switch"
          ],
          "default": "open-workspace",
          "description": "Default action when clicking a project. Keep 'open-workspace' for full VS Code folder loads, or use 'fast-switch' to focus the managed Zellij project tab."
        },
        "shuvscode.projects.projectsLocation": {
          "type": "string",
          "default": "",
          "description": "Optional folder for projects.json. Supports ~ and $home."
        },
        "shuvscode.projects.multiplexerCommand": {
          "type": "string",
          "default": "",
          "description": "Command to run in a new terminal when 'Open Multiplexer Terminal' is invoked. Supports ${projectName}, ${projectPath}, ${projectSlug}, ${cwd}. Examples: 'zellij attach -c ${projectName}', 'tmux new -A -s ${projectSlug}'."
        },
        "shuvscode.projects.multiplexerTerminalName": {
          "type": "string",
          "default": "mux: ${projectName}",
          "description": "Name template for multiplexer terminals. Supports the same tokens as multiplexerCommand. Used to find and reuse an existing session terminal."
        },
        "shuvscode.projects.autoOpenMultiplexer": {
          "type": "boolean",
          "default": false,
          "description": "Automatically open the multiplexer terminal when a project loads (only if multiplexerCommand is set)."
        },
        "shuvscode.projects.zellij.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable first-class managed Zellij project switching."
        },
        "shuvscode.projects.zellij.executablePath": {
          "type": "string",
          "default": "zellij",
          "description": "Zellij executable path or command name. Use an absolute path such as /usr/bin/zellij if shuvscode is launched from a desktop environment with a reduced PATH."
        },
        "shuvscode.projects.zellij.sessionName": {
          "type": "string",
          "default": "shuvscode-managed",
          "description": "Managed Zellij session name used by shuvscode."
        },
        "shuvscode.projects.zellij.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Create or reuse the managed Zellij session when the Projects extension activates."
        },
        "shuvscode.projects.zellij.openSharedTerminalOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Open the shared managed Zellij terminal when Projects activates."
        },
        "shuvscode.projects.zellij.fastSwitchMode": {
          "type": "string",
          "enum": [
            "zellij-only",
            "zellij-then-folder",
            "folder-only"
          ],
          "default": "zellij-only",
          "description": "Controls whether fast switching only focuses the managed Zellij tab or also opens the project as the VS Code workspace afterward."
        },
        "shuvscode.projects.zellij.tabNameTemplate": {
          "type": "string",
          "default": "${projectSlug}",
          "description": "Name template for per-project Zellij tabs. Supports ${projectName}, ${projectPath}, ${projectSlug}, ${cwd}, and ${shell}."
        },
        "shuvscode.projects.zellij.bootstrapCommand": {
          "type": "string",
          "default": "",
          "description": "Optional trusted shell command to run in newly-created project tabs. Leave empty for an idle shell."
        }
      }
    }
  }
}
